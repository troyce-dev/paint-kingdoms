{
  "rules": {
    ".read": false,
    ".write": false,
    "classes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('meta/owner').val() === auth.uid",
        "meta": {
          ".write": "auth != null && !data.exists() && newData.child('owner').val() === auth.uid",
          ".validate": "newData.hasChildren(['owner', 'round'])"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('classes/' + $code + '/meta').exists()",
            ".validate": "newData.hasChildren(['name', 'color', 'round']) && newData.child('name').isString() && newData.child('name').val().length <= 24"
          }
        },
        "colors": {
          "$cid": {
            ".write": "auth != null && newData.child('owner').val() === auth.uid && (!data.exists() || data.child('owner').val() === auth.uid || data.child('round').val() !== root.child('classes/' + $code + '/meta/round').val())"
          }
        },
        "events": {
          "$eid": {
            ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid && root.child('classes/' + $code + '/players/' + auth.uid).exists()",
            ".validate": "newData.hasChildren(['k', 'by', 't', 'round']) && newData.child('k').isString() && newData.child('k').val().length <= 8"
          }
        }
      }
    }
  }
}
